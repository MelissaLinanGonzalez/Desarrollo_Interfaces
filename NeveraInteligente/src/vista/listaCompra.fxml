<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="800.0" prefWidth="448.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controlador.ListaCompraController">
   <children>
      <ImageView fitHeight="800.0" fitWidth="448.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../imagenes/fondo%20de%20pantalla%20para%20la%20pantalla%20tactil%20de%20una%20nevera%20inteligente%20con%20tonos%20frios.jpg" />
         </image>
      </ImageView>
      <ImageView fx:id="home" fitHeight="48.0" fitWidth="48.0" layoutX="14.0" layoutY="738.0" onMouseClicked="#irHome" pickOnBounds="true" preserveRatio="true" style="-fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.6), 25, 0.4, 0, 0);">
         <image>
            <Image url="@../imagenes/icons8-página-principal-48.png" />
         </image>
      </ImageView>
      <Label fx:id="labelFecha" layoutX="40.0" layoutY="50.0">
         <font>
            <Font size="21.0" />
         </font>
      </Label>
      <Label fx:id="labelHora" layoutX="40.0" layoutY="70.0">
         <font>
            <Font size="21.0" />
         </font>
      </Label>
      <ImageView fitHeight="30.0" fitWidth="30.0" layoutX="395.0" layoutY="14.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../imagenes/icons8-wifi-48.png" />
         </image>
      </ImageView>
      <TableView fx:id="alimentosTabla" layoutX="34.0" layoutY="163.0" onMouseClicked="#seleccionarAlimento" prefHeight="401.0" prefWidth="381.0" style="-fx-background-color: #FFFFFF80; -fx-background-radius: 10;">
        <columns>
          <TableColumn fx:id="colNombre" prefWidth="159.0" style="-fx-background-radius: 10;" text="Nombre" />
          <TableColumn fx:id="colCantidad" prefWidth="93.0" style="-fx-background-radius: 10;" text="Cantidad" />
            <TableColumn fx:id="colTipo" prefWidth="128.0" style="-fx-background-radius: 10;" text="Tipo Unidad" />
        </columns>
      </TableView>
      <TextField fx:id="nombreInput" layoutX="34.0" layoutY="587.0" promptText="Nombre" />
      <TextField fx:id="cantidadInput" layoutX="34.0" layoutY="620.0" promptText="Cantidad" />
      <Button fx:id="bAgregar" layoutX="334.0" layoutY="587.0" mnemonicParsing="false" onMouseClicked="#agregarAlimento" prefHeight="26.0" prefWidth="76.0" text="Añadir" />
      <Button fx:id="bEliminar" layoutX="334.0" layoutY="620.0" mnemonicParsing="false" onMouseClicked="#eliminarAlimento" prefHeight="26.0" prefWidth="76.0" text="Eliminar" />
      <Button fx:id="bModificar" layoutX="334.0" layoutY="655.0" mnemonicParsing="false" onMouseClicked="#modificarAlimento" text="Modificar" />
      <ComboBox fx:id="comboTipo" layoutX="34.0" layoutY="655.0" prefHeight="26.0" prefWidth="162.0" promptText="Tipo Unidad" />
   </children>
</AnchorPane>
